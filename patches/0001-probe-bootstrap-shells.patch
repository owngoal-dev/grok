+    // 4) RootHide gives every Mach-O directory a `.jbroot` link to the
+    //    randomized jailbreak root. This Rust binary is not libvroot-linked,
+    //    so it must derive a physical shell path from that link itself.
+    #[cfg(target_os = "ios")]
+    if let Ok(executable) = std::env::current_exe()
+        && let Some(executable_dir) = executable.parent()
+    {
+        for dir in ["bin", "usr/bin"] {
+            let p = executable_dir.join(".jbroot").join(dir).join(name);
+            if is_executable(&p) {
+                return p.to_string_lossy().into_owned();
+            }
+        }
+    }
+
+    // 5) Common install dirs. Probe the rootless prefix first: iOS has no
+    //    /bin/sh on the real rootfs, and this binary does not go through
+    //    libvroot, so `/bin/zsh` from a vroot parent is a lie.
+    for dir in [
+        "/var/jb/bin",
+        "/var/jb/usr/bin",
+        "/bin",
+        "/usr/bin",
+        "/usr/local/bin",
+        "/opt/homebrew/bin",
+    ] {
         let p = std::path::PathBuf::from(dir).join(name);
         if is_executable(&p) {
             return p.to_string_lossy().into_owned();
         }
     }
 
